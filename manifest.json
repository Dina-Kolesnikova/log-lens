{
  "manifest_version": 3,
  "name": "Log Lens — JSON Log Viewer",
  "version": "1.5.1",
  "description": "Turn raw JSON in any log viewer into an interactive tree: collapse/expand, search keys & values, copy value/path/subtree, auto-parse JSON-in-strings.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage"],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Log Lens"
  },
  "options_ui": { "page": "src/options.html", "open_in_tab": true },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
